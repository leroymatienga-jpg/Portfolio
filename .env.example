# ========================================
# Portfolio Backend — Environment Variables
# ========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Flask ─────────────────────────────
SECRET_KEY=your-random-secret-key-here
FLASK_DEBUG=True
PORT=5000

# ─── Database ─────────────────────────
# Path to the SQLite database file (relative to app.py)
DATABASE_PATH=portfolio.db

# ─── SMTP Email Notifications ─────────
# Used to send email when someone submits the contact form.
# For Gmail: use an App Password (not your regular password).
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# The email address that receives notifications.
# Leave blank to send to SMTP_EMAIL itself.
NOTIFICATION_EMAIL=

# ─── Admin ─────────────────────────────
# API key required to access GET /api/messages
ADMIN_API_KEY=your-secure-admin-api-key

# ─── CV Download ───────────────────────
# Filename of your CV/resume (must be in the portfolio root folder)
CV_FILENAME=Leroy_Matienga_CV.pdf

# ─── Rate Limiting ────────────────────
# Max contact form submissions per IP within the time window
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
